<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Redirecting...</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- ✅ Google AdSense 認証タグ -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9751986219986270"
        crossorigin="anonymous"></script>

    <style>
        body {
            font-family: sans-serif;
            text-align: center;
            padding: 2em;
            background-color: #f8f9fa;
        }

        .ad-container {
            margin: 1em auto 2em;
            max-width: 100%;
        }

        .countdown {
            font-size: 1.5em;
            margin-top: 1em;
            color: #333;
        }

        .progress-container {
            width: 80%;
            height: 30px;
            margin: 2em auto;
            background-color: #ddd;
            border-radius: 30px;
            overflow: hidden;
            position: relative;
            box-shadow: inset 0 0 5px rgba(0,0,0,0.2);
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: repeating-linear-gradient(
                30deg,
                red,
                orange 16%,
                yellow 32%,
                green 48%,
                cyan 64%,
                blue 80%,
                violet 100%
            );
            background-size: 200% 200%;
            animation: rainbowShift 10s linear infinite;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.6);
            transition: width 5s linear;
        }

        @keyframes rainbowShift {
            0% { background-position: 0% 0%; }
            100% { background-position: 100% 100%; }
        }

        .download-now {
            margin-top: 2em;
            font-size: 1.2em;
        }

        .download-now a {
            text-decoration: none;
            background-color: #007bff;
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            display: inline-block;
        }

        .download-now a:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <!-- ✅ Google AdSense 表示枠 -->
    <div class="ad-container">
        <ins class="adsbygoogle"
            style="display:block"
            data-ad-client="ca-pub-9751986219986270"
            data-ad-slot="7697683692"
            data-ad-format="auto"
            data-full-width-responsive="true"></ins>
        <script>
            (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
    </div>

    <h1 id="title">Please wait...</h1>
    <div class="progress-container">
        <div class="progress-bar" id="progress-bar"></div>
    </div>
    <div class="countdown" id="countdown-text"></div>
    <div class="download-now" id="download-link" style="display: none;">
        <a href="https://sourceforge.net/projects/crystaldiskinfo/files/9.8.0/CrystalDiskInfo9_8_0.zip/download" id="download-now-link">Download Now</a>
    </div>

    <script>
        const delay = 7;
        const redirectUrl = "https://sourceforge.net/projects/crystaldiskinfo/files/9.8.0/CrystalDiskInfo9_8_0.zip/download";
        let countdown = delay;

        const countdownText = document.getElementById('countdown-text');
        const progressBar = document.getElementById('progress-bar');
        const downloadLink = document.getElementById('download-link');
        const downloadNowLink = document.getElementById('download-now-link');
        const title = document.getElementById('title');

        const lang = navigator.language || navigator.userLanguage;
        const isJapanese = lang.startsWith('ja');

        function updateText() {
            if (isJapanese) {
                title.textContent = "ダウンロードまでお待ちください...";
                countdownText.textContent = countdown + " 秒後にダウンロードが開始されます。";
                downloadLink.querySelector('a').textContent = "今すぐダウンロード";
            } else {
                title.textContent = "Please wait before downloading...";
                countdownText.textContent = "Download will start in " + countdown + " seconds.";
                downloadLink.querySelector('a').textContent = "Download Now";
            }
        }

		function tick() {
		    const elapsed = delay - countdown;
		    const percent = Math.min((elapsed / delay) * 100, 100);
		    progressBar.style.width = percent + "%";

		    if (countdown <= 0) {
		        countdownText.style.display = 'none';
		        downloadLink.style.display = 'block';
		        window.location.href = redirectUrl;
		        progressBar.style.animation = "none";
		        
		        setTimeout(function () {
                window.location.href = document.referrer || 'index.php'; // リファラー（元ページ）に戻る
            	}, 10000); // 10秒後にリダイレクト
            
		        return;
		    }

		    updateText();
		    countdown--;
		    setTimeout(tick, 1000);
		}

        // ダウンロードリンクがクリックされた時
        downloadNowLink.addEventListener('click', function (event) {
            event.preventDefault(); // デフォルトのリンク遷移を防ぐ
            window.location.href = redirectUrl; // ダウンロードを開始
            setTimeout(function () {
                window.location.href = document.referrer || 'index.php'; // リファラー（元ページ）に戻る
            }, 10000); // 10秒後にリダイレクト
        });

        // 初期表示更新
        updateText();
        progressBar.style.width = "0%";
        setTimeout(tick, 1000);
    </script>
</body>
</html>
